<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080B12">

    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" app:implementationMode="performance" app:scaleType="fillCenter" />

    <View android:id="@+id/focusFrame" android:layout_width="match_parent" android:layout_height="430dp" android:layout_gravity="center" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:background="@drawable/bg_receipt_frame" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="15dp" android:paddingTop="14dp" android:paddingEnd="15dp" android:paddingBottom="16dp" android:background="#A8000000">
        <ImageButton android:id="@+id/backButton" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="Back" android:padding="9dp" android:src="@drawable/ic_back" app:tint="@android:color/white" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Receipt scanner" android:textColor="@android:color/white" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/subtitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Fit the full receipt inside the frame" android:textColor="#C7D0E0" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/flashButton" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="Flash" android:padding="9dp" android:src="@drawable/ic_flash" app:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout android:id="@+id/cameraControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:background="#B0000000">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="13dp" android:text="One photo detects the 4 receipt fields" android:textColor="#D9E0EC" android:textSize="12sp" />
        <ImageButton android:id="@+id/captureButton" android:layout_width="78dp" android:layout_height="78dp" android:background="@drawable/bg_camera_button" android:contentDescription="Capture receipt" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/reviewPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:background="@color/s2c_background" android:paddingTop="84dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="24dp">
            <ImageView android:id="@+id/receiptImage" android:layout_width="match_parent" android:layout_height="150dp" android:adjustViewBounds="true" android:background="#E8EDF5" android:scaleType="centerCrop" />
            <TextView android:id="@+id/detectedStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_detected_chip" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="0 / 4 detected" android:textColor="@color/s2c_primary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="The two long references at the bottom are filled left → right. Use Swap IDs if your Excel meaning is reversed." android:textColor="@color/s2c_muted" android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="N° Trésorerie">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/treasuryInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Nom &amp; Prénom">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="N° Contrat">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/contractInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Montant">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/amountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/swapIdsButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:text="↔ Swap the two reference numbers" android:textAllCaps="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/retakeButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Retake" android:textAllCaps="false" app:cornerRadius="14dp" />
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/sendReceiptButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.6" android:text="Send receipt to Excel" android:textAllCaps="false" android:textStyle="bold" app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/loadingPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="#E61A2030" android:gravity="center" android:orientation="vertical" android:padding="22dp" android:visibility="gone">
        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Reading receipt…" android:textColor="@android:color/white" android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
