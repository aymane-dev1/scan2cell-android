<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Scan2Cell" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/s2c_primary</item>
        <item name="colorSecondary">@color/s2c_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/s2c_background</item>
        <item name="android:navigationBarColor">@color/s2c_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Scan2Cell.Scanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/s2c_primary</item>
        <item name="android:statusBarColor">@color/s2c_black</item>
        <item name="android:navigationBarColor">@color/s2c_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
